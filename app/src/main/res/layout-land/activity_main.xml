<?xml version="1.0" encoding="utf-8"?>
<!--
    CampusLife home screen (landscape).

    Identical to the portrait layout in res/layout/activity_main.xml apart from the
    topic area: the four buttons are laid out next to each other in a single row
    instead of a two-by-two grid.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ================= Banner ================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2">

        <ImageView
            android:id="@+id/img_main_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/banner_description"
            android:scaleType="centerCrop"
            android:src="@drawable/img_main_banner" />

        <TextView
            android:id="@+id/txt_welcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_medium"
            android:shadowColor="@color/text_shadow"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="6"
            android:text="@string/welcome_message"
            android:textColor="@color/white"
            android:textSize="@dimen/banner_title_text_size" />
    </FrameLayout>

    <!-- ================= Topic row (1 x 4) ================= -->
    <LinearLayout
        android:id="@+id/layout_topics"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:background="@color/green"
        android:orientation="horizontal">

        <!-- Facilities -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_small">

            <ImageButton
                android:id="@+id/btn_facilities"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/btn_selector"
                android:contentDescription="@string/facilities"
                android:onClick="onFacilitiesClicked"
                android:padding="@dimen/button_icon_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_facilities" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="@dimen/spacing_small"
                android:text="@string/facilities"
                android:textColor="@color/white"
                android:textSize="@dimen/topic_label_text_size" />
        </LinearLayout>

        <!-- Events -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_small">

            <ImageButton
                android:id="@+id/btn_events"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/btn_selector"
                android:contentDescription="@string/events"
                android:onClick="onEventsClicked"
                android:padding="@dimen/button_icon_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_events" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="@dimen/spacing_small"
                android:text="@string/events"
                android:textColor="@color/white"
                android:textSize="@dimen/topic_label_text_size" />
        </LinearLayout>

        <!-- Clubs -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_small">

            <ImageButton
                android:id="@+id/btn_clubs"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/btn_selector"
                android:contentDescription="@string/clubs"
                android:onClick="onClubsClicked"
                android:padding="@dimen/button_icon_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_clubs" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="@dimen/spacing_small"
                android:text="@string/clubs"
                android:textColor="@color/white"
                android:textSize="@dimen/topic_label_text_size" />
        </LinearLayout>

        <!-- Support -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_small">

            <ImageButton
                android:id="@+id/btn_support"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/btn_selector"
                android:contentDescription="@string/support"
                android:onClick="onSupportClicked"
                android:padding="@dimen/button_icon_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_support" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="@dimen/spacing_small"
                android:text="@string/support"
                android:textColor="@color/white"
                android:textSize="@dimen/topic_label_text_size" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
